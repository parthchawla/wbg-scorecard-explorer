# Copy to .env and fill in. Real environment variables (e.g. Hugging Face Space secrets) override this file.

# --- LLM (required) ---------------------------------------------------------
# Anthropic API key. ANTHROPIC_API_KEY also works.
LLM_API_KEY=
# Model: claude-sonnet-5-5 (default), claude-opus-5-5 or claude-haiku-5-5
LLM_MODEL_NAME=claude-sonnet-5-5
# Optional: custom endpoint for an Anthropic-compatible gateway/proxy (leave empty for api.anthropic.com)
LLM_BASE_URL=
# Reasoning effort: low | medium | high
LLM_EFFORT=medium

# --- Agent ------------------------------------------------------------------
MAX_TOOL_ROUNDS=8
# Re-ask the model once if the grounding check finds unverified figures
VERIFY_RETRY=true

# --- Public-deployment guardrails -------------------------------------------
RATE_LIMIT_PER_HOUR=30
DAILY_BUDGET_USD=10
MAX_INPUT_CHARS=2000
MAX_TURNS_PER_SESSION=20

# --- Data (optional overrides; defaults work out of the box) -----------------
# SCORECARD_DATA_DIR=./data
# SCORECARD_SNAPSHOTS=2024,2025,2026
